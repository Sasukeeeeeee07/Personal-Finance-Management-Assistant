# Leave DATABASE_URL empty to use embedded PGlite (local dev only; data in PGLITE_DATA_DIR).
DATABASE_URL=
PGLITE_DATA_DIR=./.pgdata
PORT=4000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=
APP_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
