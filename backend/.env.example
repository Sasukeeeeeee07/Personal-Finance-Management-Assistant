# Copy to .env for local development. PLACEHOLDERS ONLY — never commit real values.
# In production (Render) set these in the dashboard; see docs/DEPLOYMENT.md.

NODE_ENV=development
PORT=4000

# --- Database ---
# Empty = embedded PGlite (local development only; data in PGLITE_DATA_DIR).
# Production (Neon): the POOLED connection string, e.g.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=
PGLITE_DATA_DIR=./.pgdata

# --- Auth ---
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Optional Google sign-in (comma-separated OAuth client IDs). Leave empty to disable.
GOOGLE_CLIENT_IDS=

# --- Web app ---
# Address of the Flutter web app; used in password-reset and verify-email links.
# Production: must be https://, e.g. https://your-app.vercel.app
APP_WEB_URL=http://localhost:5180
# Browser origins allowed to call the API (comma-separated). Production: https:// origins only, no *.
# In development any http://localhost:<port> is allowed automatically.
CORS_ORIGINS=http://localhost:5180

# --- Email (optional) ---
# Leave SMTP_HOST empty to disable sending. Production then logs only a warning (never the link or token).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Operations ---
# Swagger UI at /api/docs. On by default in development; off in production unless set to true.
ENABLE_API_DOCS=
# Number of proxies in front of the app (Render = 1). Defaults to 1 in production, 0 otherwise.
TRUST_PROXY=
